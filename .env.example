# MADETRUE — environment template
#
# How to use:
#   1. Copy this file:      cp .env.example .env.local
#   2. Fill values when the matching phase starts (each block says which).
#   3. NEVER commit .env.local. Never paste secret keys into chat or tickets —
#      add them to .env.local yourself.
#
# Until then the app runs entirely on mock data and needs no env vars.

# ── Supabase (Phase 2: database + storage) ─────────────────────────
# Public values — safe to appear in the browser bundle:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret. Never prefix with NEXT_PUBLIC_. Never commit:
SUPABASE_SERVICE_ROLE_KEY=
# Data-source switch: mock | supabase (Phase 2).
# With "supabase": catalog reads and checkout/product/profile writes go
# through Supabase (writes via server routes with the service role).
# "mock" needs no keys at all — everything runs on localStorage/mockData —
# and stays as the default + fallback. The public copy is what the browser
# bundle sees; the plain name covers server code. Keep both lines in sync.
MADETRUE_DATA_SOURCE=mock
NEXT_PUBLIC_MADETRUE_DATA_SOURCE=mock
# On Vercel (production deploys) set BOTH to supabase in every environment
# scope — see docs/production-deploy.md for the full table.

# ── Payments (Phase 6: Cashfree Easy Split — PRIMARY) ───────────────
# Cashfree Payment Gateway + Easy Split: split settlements at source —
# the seller's share settles to their verified bank account (gateway
# vendor) and MadeTrue's commission is retained automatically.
# Start with SANDBOX/TEST credentials. Only the app id appears client-side;
# the secret and webhook secret are SERVER-ONLY. Never commit real secrets.
# Approved alternates behind the same adapter: Razorpay Route / PayU Split.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Cashfree environment: sandbox | production (server-only config)
CASHFREE_ENV=

# ── WhatsApp automation (Phase 7: order updates) ───────────────────
# One small server-side adapter chooses the provider. Leave WHATSAPP_PROVIDER
# blank to stay on wa.me click-to-chat links — that is the honest default,
# nothing sends, and no order ever blocks on WhatsApp.
# Supported values: twilio | wati
WHATSAPP_PROVIDER=
# Twilio WhatsApp (sandbox number is fine for testing):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# WATI (free-form session messages):
WATI_ENDPOINT=
WATI_API_TOKEN=

# ── Email delivery (Phase 3 / 9: verification, order mail) ─────────
RESEND_API_KEY=

# ── Monitoring & Error Tracking (Phase 9: Sentry) ─────────────────
# Sentry DSN for client and server error reporting.
# Leave blank to run locally without external error reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# On Vercel: set org/project/auth token in every scope so next.config.ts
# (withSentryConfig) can upload source maps during the build.

# ── Site & deploy basics (Phase 10 Step 3: Vercel production) ─────
# Canonical public URL — the only URL var the app reads. lib/utils/
# constants.ts (SITE_URL) feeds metadataBase, sitemap.xml, robots.txt
# and Open Graph from it; Vercel's own VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL are automatic fallbacks.
#   Vercel Production:  https://madetrue.in
#   Vercel Preview:     leave unset — previews then report their own
#                       VERCEL_URL, so OG/links stay honest per deploy
#   Local dev:          leave unset (no sitemap/OG dependency locally)
# Set it in the Vercel dashboard (Settings → Environment Variables),
# never in git. Full runbook: docs/production-deploy.md.
NEXT_PUBLIC_SITE_URL=
